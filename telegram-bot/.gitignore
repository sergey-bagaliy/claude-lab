# Виртуальное окружение и кэш Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Файлы, где могут оказаться ключи. Ключи в репозиторий не кладём!
.env
.env.*
!.env.example
*.key
secrets*

# Логи и база данных бота (там семейные данные — в репозиторий не кладём)
*.log
*.log.*
*.db
*.db-journal

# Данные бота и модели для голоса (на сервере — папки data и models)
data/
models/
backups/
