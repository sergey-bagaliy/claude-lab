# Пример настроек. Скопируйте в .env и впишите свои значения:
#   cp .env.example .env && nano .env && chmod 600 .env
# Файл .env в git не попадает. Никогда не пересылайте его и не выкладывайте.

# Обязательно
TELEGRAM_BOT_TOKEN=сюда_токен_от_BotFather
ANTHROPIC_API_KEY=сюда_ключ_из_Claude_Console

# Кто может пользоваться ботом (Telegram ID через запятую)
ALLOWED_USER_IDS=
# Ваш Telegram ID: сюда придут уведомления о расходах (и копии базы, если включить ниже)
ADMIN_USER_ID=

# Дневной лимит расходов на Claude в долларах (0 — без лимита)
DAILY_BUDGET_USD=1

# Резервные копии: сколько дней хранить и присылать ли копию вам в Telegram (1 — да)
BACKUP_KEEP_DAYS=14
BACKUP_TO_TELEGRAM=0

# Голос: 1 — включён, 0 — выключен. Модель распознавания: small (лучше) или base (легче)
VOICE=1
WHISPER_MODEL=small
PIPER_VOICE=ru_RU-irina-medium
