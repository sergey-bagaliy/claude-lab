# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env в git НЕ попадает (см. .gitignore). Никогда не публикуйте ключи.

# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# Ключ API Anthropic из console.anthropic.com (обязательно)
ANTHROPIC_API_KEY=

# ID чата владельца: напишите боту /myid и впишите число (заявки будут приходить туда)
OWNER_CHAT_ID=

# Какой конфиг ниши использовать
BUSINESS_CONFIG=configs/dentistry.yaml

# Файл базы данных (записи, согласия, история диалогов)
DB_PATH=data/bot.db

# Модель Claude и «глубина размышлений» (low | medium | high | xhigh | max)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# Сколько последних сообщений диалога помнит бот
HISTORY_MESSAGES=20
